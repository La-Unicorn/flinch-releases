<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Flinch_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Flinch_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: User-Visible Status & Privacy Badges -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                    <TextBlock x:Name="StatusTextBlock"
                               Text="Status: Ready (No background recording or capture)"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Padding="8,4">
                        <TextBlock x:Name="ScreenStatusText"
                                   Text="📸 Screen: Not Shared"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Padding="8,4">
                        <TextBlock x:Name="AudioStatusText"
                                   Text="🎙️ Mic: Idle"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Button x:Name="TtsMuteButton"
                            Padding="8,4"
                            AutomationProperties.Name="Toggle Text-to-Speech Audio Mute"
                            AutomationProperties.HelpText="Mutes or unmutes spoken explanations during animated drawings"
                            Click="OnTtsMuteClicked">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon x:Name="TtsMuteIcon" Glyph="&#xE767;" FontSize="12" />
                            <TextBlock x:Name="TtsMuteText" Text="Audio: ON" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CENTER: Chat / Transcript Panel -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Conversation &amp; Screen Explanation Transcript"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="13"
                           Margin="4,2,4,4" />

                <ListView x:Name="TranscriptListView"
                          Grid.Row="1"
                          AutomationProperties.Name="Conversation and Screen Explanation Transcript"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TranscriptEntry">
                            <Border Margin="0,4"
                                    Padding="14,10"
                                    CornerRadius="8"
                                    Background="{x:Bind BackgroundBrush}"
                                    BorderBrush="{x:Bind BorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="{x:Bind Alignment}">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Sender}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="{x:Bind SenderForegroundBrush}" />
                                        <TextBlock Text="{x:Bind Timestamp}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Message}"
                                               TextWrapping="Wrap"
                                               FontSize="14" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- BOTTOM CONTROLS: Action Buttons, Push-to-Talk Placeholder, and Query Input -->
        <StackPanel Grid.Row="2" Spacing="12">
            <!-- EPHEMERAL PREVIEW CONTAINER (Stage 2) -->
            <Border x:Name="PreviewCard"
                    Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE790;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                            <TextBlock x:Name="PreviewTitleText" Text="Ephemeral Preview: Selected Target" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="PreviewDimensionsText" Text="1920x1080" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Border Grid.Row="1"
                            MaxHeight="180"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            CornerRadius="6"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                    </Border>

                    <!-- STAGE 3: Bounded Context & Privacy Inspector -->
                    <StackPanel Grid.Row="2" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D7;" FontSize="12" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                            <TextBlock x:Name="PreviewContextSummaryText"
                                       Text="Indexing accessible controls &amp; OCR text..."
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <Expander Header="Inspect Shared Context Payload (UIA + OCR + Coordinates)"
                                  HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6" Padding="4">
                                <TextBlock Text="&#x1F512; Privacy Notice: All screen strings are treated as untrusted input. Ephemeral frame is disposed upon discard or query completion."
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ScrollViewer MaxHeight="130" HorizontalScrollBarVisibility="Auto">
                                    <TextBox x:Name="ContextInspectorTextBox"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True" />
                                </ScrollViewer>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <Grid Grid.Row="3" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DiscardCaptureButton"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Cancel and Discard Screen Capture"
                                AutomationProperties.HelpText="Immediately purges the captured frame from memory"
                                Click="OnDiscardCaptureClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="Cancel (Discard &amp; Dispose)" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ConfirmCaptureButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Confirm Screen Capture"
                                AutomationProperties.HelpText="Attaches bounded OCR and UIA coordinates to context"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnConfirmCaptureClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" />
                                <TextBlock Text="Confirm (Attach to Context)" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Buttons Row: Explicit Screen Share + Push-to-Talk Placeholder -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ShareScreenButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        AutomationProperties.Name="Share Screen or Window Target"
                        AutomationProperties.HelpText="Opens the system graphics capture picker to select a window or display"
                        Click="OnShareScreenClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE790;" />
                        <TextBlock Text="Share Screen / Window" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button x:Name="PushToTalkButton"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        AutomationProperties.Name="Push to Talk Voice Input"
                        AutomationProperties.HelpText="Press to activate microphone and speak a question"
                        Click="OnPushToTalkClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="PushToTalkIcon" Glyph="&#xE720;" />
                        <TextBlock x:Name="PushToTalkText" Text="Push to Talk (Placeholder - Idle)" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- STAGE 5: Native Transparent Overlay Action Strip -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="TriggerOverlayButton"
                        HorizontalAlignment="Stretch"
                        Height="34"
                        AutomationProperties.Name="Demonstrate Synchronized Speech and Animated Overlays"
                        AutomationProperties.HelpText="Triggers an animated drawing demonstration synchronized with TTS speech"
                        Click="OnTriggerOverlayClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE890;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                        <TextBlock Text="Trigger Stage 5 Native Overlay (Outline, Arrow, Label, Equation)" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button x:Name="DismissOverlayButton"
                        Grid.Column="1"
                        Height="34"
                        AutomationProperties.Name="Dismiss All Active Overlays"
                        AutomationProperties.HelpText="Clears all visual shapes and cancels ongoing speech and drawing"
                        Click="OnDismissOverlayClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="Dismiss Overlay" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Query Input Row -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="QueryInputTextBox"
                         AutomationProperties.Name="Question and Math Query Input Box"
                         PlaceholderText="Ask a question or request on-screen math help..."
                         KeyDown="OnQueryInputKeyDown" />

                <Button x:Name="SendQueryButton"
                        Grid.Column="1"
                        AutomationProperties.Name="Send Query"
                        Style="{ThemeResource AccentButtonStyle}"
                        Width="80"
                        Click="OnSendQueryClicked">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE724;" FontSize="12" />
                        <TextBlock Text="Send" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
