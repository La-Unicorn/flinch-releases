<UserControl
    x:Class="Flinch_App.Overlay.OverlayCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <!-- Canvas for dynamic shapes -->
        <Canvas x:Name="ShapesCanvas" Background="Transparent" />

        <!-- Floating HUD Header (Non-intrusive top-center controller) -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,16,0,0"
                Padding="12,6"
                Background="#EE1E1E24"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="20">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE890;" FontSize="13" Foreground="#3DDC84" />
                    <TextBlock Text="Flinch Overlay Active"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="White"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Click-Through Toggle Button -->
                <Button x:Name="ClickThroughButton"
                        Padding="8,4"
                        FontSize="11"
                        CornerRadius="12"
                        Click="OnClickThroughToggleClicked">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon x:Name="ClickThroughIcon" Glyph="&#xE7C5;" FontSize="11" />
                        <TextBlock x:Name="ClickThroughText" Text="Click-Through: OFF" />
                    </StackPanel>
                </Button>

                <!-- Dismiss Button -->
                <Button x:Name="DismissButton"
                        Padding="8,4"
                        FontSize="11"
                        CornerRadius="12"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnDismissClicked">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                        <TextBlock Text="Dismiss (Esc)" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
